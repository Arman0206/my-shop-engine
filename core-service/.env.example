PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/smartcart
# REQUIRED. >= 32 chars. Must be identical in recommendation-service.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime (default 2h)
JWT_EXPIRES_IN=2h
# Browser origins allowed to call this API (comma-separated). Required in production.
CORS_ORIGIN=http://localhost:5173
