PORT=5002
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/smartcart
CORE_SERVICE_URL=http://localhost:5001
GEMINI_API_KEY=
# REQUIRED. Same value as core-service.
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173

# ---- Optional tuning (defaults shown)
# EMBEDDING_CACHE_MAX=5000
# RECOMMENDATION_CACHE_TTL_MS=300000
# RECOMMENDATION_CACHE_MAX=500
# RECOMMENDATION_RATE_LIMIT=30          # requests / minute / user
# CORE_RETRY_ATTEMPTS=3
# CORE_RETRY_BASE_MS=200
# CANDIDATE_LIMIT=200                   # max candidates scored (core caps at 500)
# CANDIDATE_MAX_PRICE_RATIO=2           # only candidates priced <= 2x the selected product
# CANDIDATE_SAME_CATEGORY=false         # true = same category only (disables cross-category cross-sell)
